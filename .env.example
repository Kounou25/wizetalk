# Cle API Google Gemini -> https://aistudio.google.com/apikey
# Copier ce fichier vers .env et y mettre la vraie cle.
# .env est ignore par git ; ce fichier-ci ne doit JAMAIS contenir de secret.
GEMINI_API_KEY=

# Modeles. `npm run models` liste ceux accessibles avec VOTRE cle :
# Google ferme les anciens modeles aux nouveaux comptes.
# Ne pas passer a gemini-embedding-2 : il ne traite pas les lots.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Attention : gemini-3.6-flash est plafonne a 20 requetes/jour en gratuit.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# 768 dims : compatible avec l'index HNSW de pgvector (limite 2000 dims).
# Ne pas monter a 3072 (defaut du modele) : l'index HNSW devient impossible.
EMBEDDING_DIMENSIONS=768

# --- Supabase ---
# Tableau de bord -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contourne le RLS : cote serveur uniquement, jamais expose au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'app, utilisee dans le script d'integration du widget.
NEXT_PUBLIC_APP_URL=http://localhost:3000
